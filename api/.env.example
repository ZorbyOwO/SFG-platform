# Canonical cross-team configuration names. Replace placeholders only in api/.env.
APP_ENV=development
API_BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
LOG_LEVEL=INFO
DATABASE_URL=
YUNET_MODEL_PATH=
SFACE_MODEL_PATH=
PAD_MODEL_DIR=
SFACE_MATCH_THRESHOLD=0.40
SFACE_AMBIGUITY_MARGIN=0.05
PAD_ACCEPT_THRESHOLD=0.70
PAD_REJECT_THRESHOLD=0.30
BIOMETRIC_TEMPLATE_ENCRYPTION_KEY=
PIN_MAX_ATTEMPTS=3
SESSION_TIMEOUT_SECONDS=90
PADDLEOCR_LANG=en
PADDLEOCR_MODEL_DIR=

# Trusted-tier Supabase upload path for completed enrolments (server-side only).
# SUPABASE_BACKEND_SECRET is a service_role-class secret. Never set a VITE_ variable
# to this value; the browser bundle must never see it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BACKEND_SECRET=

# Architecture component-internal development settings.
FACE_ONLY_MODE=false
MAX_IDENTIFY_FRAMES=10
MAX_UPLOAD_BYTES=5242880
TRANSFER_MIN_AMOUNT=1.00
TRANSFER_MAX_AMOUNT=1000.00
MAX_FAMILY_MEMBERS=10
ENROL_FRAMES_REQUIRED=3
ENROL_REQUIRED_POSITIONS=front,right,left
